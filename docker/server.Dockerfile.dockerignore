# docker/server.Dockerfile's build context (the repository root): only what it reads.
# Never game/, build/, research/ or packaging/ (game files, binaries, local builds).
*
!server/package.json
!server/package-lock.json
!server/*.mjs
!port/
port/native/
!web/
!scripts/build_port.py
!scripts/build_unshield_wasm.sh

# Copy to .env (cp .env.example .env; chmod 600 .env) and fill it in. .env is never committed.

# The players' password (required). The lobby asks for it, or it goes in online.ini.
GTA2_PASSWORD=

# The address the players use: this machine's IP on the network (192.168.1.20), or a name.
GTA2_HOST=

# The HTTPS port. 443 unless something else uses it (8443, say).
GTA2_HTTPS_PORT=443
# The plain HTTP port: redirects to HTTPS, Let's Encrypt's checks, /ca.crt.
GTA2_HTTP_PORT=80

# Certificates: internal (Caddy's own authority, which the clients must trust: ./ca.sh), or your
# e-mail address for Let's Encrypt (GTA2_HOST a public name, ports 80 and 443 open from the
# Internet; nothing to trust on the clients).
GTA2_TLS=internal

# yes: the authority's certificate at http://<GTA2_HOST>/ca.crt, for phones and browsers.
# Check its fingerprint against ./ca.sh's before trusting it.
GTA2_SHARE_CA=no

# relay: consoles only. web: also the browser game, of the same version as the consoles.
# Add a commit (relay-93cbf31) to stay on one version.
GTA2_IMAGE=relay

# The invite link's address, if not https://GTA2_HOST:GTA2_HTTPS_PORT (behind another proxy).
#GTA2_PUBLIC_URL=

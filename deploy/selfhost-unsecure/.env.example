# Copy to .env (cp .env.example .env; chmod 600 .env) and fill it in. .env is never committed.

# The players' password (required). The lobby asks for it, or it goes in online.ini.
# Without HTTPS it crosses the network in clear: don't reuse one that matters.
GTA2_PASSWORD=

# The address the players use: this machine's IP on the network (192.168.1.20), or a name.
GTA2_HOST=

# The port the players connect to (ws://GTA2_HOST:GTA2_PORT).
GTA2_PORT=8790
# The interface it listens on: 0.0.0.0 for all, or one address (the LAN's or a VPN's).
GTA2_BIND=0.0.0.0

# relay: consoles only. web: also the browser game, of the same version as the consoles.
# Add a commit (relay-93cbf31) to stay on one version. To serve the game files to browsers:
# compose.override.disabled.yml (README.md, "Serve the game files").
GTA2_IMAGE=relay

# The invite link's address, if not http://GTA2_HOST:GTA2_PORT (behind another proxy).
#GTA2_PUBLIC_URL=

# Project-local installs (kept inside the workspace on purpose)
node_modules/

# npm temporary caches
.npm-cache/

# Local originals, audit checkouts, SDKs, and build products
downloads/
game/
research/
build/

# Generated game packs, captures, converted media and dumps (never committed)
*.gta2pack
*.gta2save

# Native build: clangd link made by scripts/build_native.sh
/compile_commands.json

# The PortMaster port being assembled by hand (launch script, tools, zip): local for now
/portmaster/

# GTA2 demo files (user-provided game data, never committed)
/data-demo/

# PortMaster zip files and binaries
/packaging/portmaster/*.zip
/packaging/portmaster/gta2/gta2.aarch64
/packaging/portmaster/gta2/gta2-lan.aarch64
/packaging/portmaster/gta2/gta2-online.aarch64
# deploy/selfhost: what a running server keeps next to compose.yml (never committed)
# the settings, with the password
/deploy/selfhost/.env
# the exported authority (ca.sh)
/deploy/selfhost/gta2-ca.pem
# saved crews: players' and crews' names (the folder itself is kept by its .gitkeep)
/deploy/selfhost/db/*
!/deploy/selfhost/db/.gitkeep
# the game files, mounted for browsers (the folder itself is kept by its .gitkeep)
/deploy/selfhost/gamedata/*
!/deploy/selfhost/gamedata/.gitkeep
# local changes (compose.override.disabled.yml is the template)
/deploy/selfhost/compose.override.yml
# deploy/selfhost-unsecure: the same, without Caddy
/deploy/selfhost-unsecure/.env
/deploy/selfhost-unsecure/db/*
!/deploy/selfhost-unsecure/db/.gitkeep
/deploy/selfhost-unsecure/gamedata/*
!/deploy/selfhost-unsecure/gamedata/.gitkeep
/deploy/selfhost-unsecure/compose.override.yml
# deploy/legacy: the droplet's folders, should they ever appear here
/deploy/legacy/data/

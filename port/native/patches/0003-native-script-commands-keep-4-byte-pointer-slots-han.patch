\ No newline at end of file
+EXTERN_GLOBAL(miss2_0x11C_Pool*, miss2_0x11C_Pool_6F8064);
+#if defined(GTA2_PORT_NATIVE)
+// The SCR_* commands are read in place from the .scr file's bytes, so their fields must
+// sit where the file has them (the offset is in each field's name). With 8-byte pointers
+// they would not; GTA2_SCR_PTR keeps those slots at 4 bytes (port_scr_ptr.hpp).
+#include <stddef.h>
+#define GTA2_SCR_OFFSET(type, field, offset) \
+    static_assert(offsetof(type, field) == offset, #type "::" #field " must be at " #offset " as in the .scr file");

+GTA2_SCR_OFFSET(SCR_PLAYER_PED, field_1A_remap, 0x1A)
+GTA2_SCR_OFFSET(SCR_CHAR_DATA_DEC, field_C_pos, 0xC)
+GTA2_SCR_OFFSET(SCR_CHAR_DATA_DEC, field_1E_padding, 0x1E)
+GTA2_SCR_OFFSET(SCR_OBJ_DATA, field_C_pos, 0xC)
+GTA2_SCR_OFFSET(SCR_OBJ_DATA, field_1C_value_shop_type, 0x1C)
+GTA2_SCR_OFFSET(SCR_POINTER, field_8_char, 0x8)
+GTA2_SCR_OFFSET(SCR_THREAD, field_C_thread_id, 0xC)
+GTA2_SCR_OFFSET(SCR_THREAD, field_10_char_idx, 0x10)
+GTA2_SCR_OFFSET(SCR_THREAD, field_16_flag, 0x16)
+GTA2_SCR_OFFSET(SCR_CHAR_AREA_ANY, field_C, 0xC)
+GTA2_SCR_OFFSET(SCR_CHAR_AREA_ANY, field_10_x, 0x10)
+GTA2_SCR_OFFSET(SCR_CHAR_AREA_ANY, field_27_flag, 0x27)
+GTA2_SCR_OFFSET(SCR_CRANE_TARGET_DEC, field_C_homecrane, 0xC)
+GTA2_SCR_OFFSET(SCR_CRANE_TARGET_DEC, field_26_unk6, 0x26)
+GTA2_SCR_OFFSET(SCR_CRANE_BASIC_DEC, field_C_homecrane, 0xC)
+GTA2_SCR_OFFSET(SCR_CRANE_BASIC_DEC, field_28_second_pos, 0x28)
+GTA2_SCR_OFFSET(SCR_DOOR_DATA_DEC, field_C_block, 0xC)
+GTA2_SCR_OFFSET(SCR_DOOR_DATA_DEC, field_14_check, 0x14)
+GTA2_SCR_OFFSET(SCR_DOOR_DATA_DEC, field_28_flip, 0x28)
+GTA2_SCR_OFFSET(SCR_ARROW_ENTITY, field_8_car, 0x8)
+static_assert(sizeof(SCR_POINTER) == 0xC, "SCR_POINTER is 12 bytes in the .scr file");
+static_assert(sizeof(SCR_ARROW_ENTITY) == 0xC, "SCR_ARROW_ENTITY is 12 bytes in the .scr file");

diff --git a/Source/port_scr_ptr.hpp b/Source/port_scr_ptr.hpp
new file mode 100644
index 00000000..5f27b77d
--- /dev/null
+++ b/Source/port_scr_ptr.hpp
@@ -0,0 +1,44 @@
+#pragma once
+// Pointers kept inside mission-script commands (native port, LP64).
+//
+// The .scr script is loaded as bytes (ScriptManager_C1EA8::field_334C_script_data) and its
+// commands are read in place through the SCR_* structures. The game stores run-time
+// pointers (the Ped, car, object... a command declared) in a 4-byte slot of the command
+// itself. On LP64 an 8-byte pointer would move every later field of the command and
+// overwrite the next command's bytes.
+//
+// GTA2_SCR_PTR(T) is a plain T* everywhere else. In the native LP64 build it is a 4-byte
+// handle into a table of pointers (port/native/platform/scr_handles.cpp); handle 0 is the
+// null pointer, so a zeroed slot (as in the file) still reads as "no object".
+#include "types.hpp"
+
+#if defined(GTA2_PORT_NATIVE) && defined(__LP64__)
+extern "C" u32 Gta2Native_ScrHandleFromPtr(void* p);
+extern "C" void* Gta2Native_ScrPtrFromHandle(u32 handle);
+
+template <typename T>
+struct ScrPtr32
+{
+    // No constructors: the structure stays trivial, as the unions holding it require.
+    u32 mHandle;
+
+    operator T*() const
+    {
+        return static_cast<T*>(Gta2Native_ScrPtrFromHandle(mHandle));
+    }
+    T* operator->() const
+    {
+        return *this;
+    }
+    ScrPtr32& operator=(T* p)
+    {
+        mHandle = Gta2Native_ScrHandleFromPtr(p);
+        return *this;
+    }
+};
+static_assert(sizeof(ScrPtr32<void>) == 4, "script pointer slots are 4 bytes");
+
+#define GTA2_SCR_PTR(T) ScrPtr32<T>
+#else
+#define GTA2_SCR_PTR(T) T*
+#endif

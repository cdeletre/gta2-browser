@@ -573,6 +650,46 @@ void gtx_0x106C::SetSpriteIndexDataPtrs_5AAC40()
 
 MATCH_FUNC(0x5AAC70)
 void gtx_0x106C::build_delta_container_5AAC70()
+#if defined(GTA2_PORT_NATIVE)
+{
+    // Native: entry sizes as in load_delx_5AAB30, and room for 8-byte entry pointers
+    // (the original allocates 4 * maxSprite + 8).
+    u32 off = 0;
+    sprite_deltas* pIter = (sprite_deltas*)field_50_delta_buffer;
+    u16 maxSprite = 0;
+    for (; off < (u32)field_60_delta_len;)
+    {
+        if (pIter->field_0_which_sprite >= maxSprite)
+        {
+            maxSprite = pIter->field_0_which_sprite;
+        }
+        u32 size = GTA2_NATIVE_DELTAS_SIZE(pIter->field_2_count);
+        off += size;
+        pIter = (sprite_deltas*)((u8*)pIter + size);
+    }
+
+    field_54_del = (delta_container*)Memory::malloc_4FE4D0(offsetof(delta_container, field_4_entries) +
+                                                           sizeof(sprite_deltas*) * (maxSprite + 1));
+    field_54_del->field_0_count = maxSprite + 1;
+    for (u32 i = 0; i < field_54_del->field_0_count; i++)
+    {
+        field_54_del->field_4_entries[i] = 0;
+    }
+
+    pIter = (sprite_deltas*)field_50_delta_buffer;
+    for (u32 off2 = 0; off2 < (u32)field_60_delta_len;)
+    {
+        if (field_54_del->field_4_entries[pIter->field_0_which_sprite])
+        {
+            FatalError_4A38C0(Gta2Error::MultipleSpriteDeltas, "C:\\Splitting\\Gta2\\Source\\style.cpp", 996, pIter->field_0_which_sprite);
+        }
+        field_54_del->field_4_entries[pIter->field_0_which_sprite] = pIter;
+        u32 size = GTA2_NATIVE_DELTAS_SIZE(pIter->field_2_count);
+        pIter = (sprite_deltas*)((u8*)pIter + size);
+        off2 += size;
+    }
+}
+#else
 {
     u32 off = 0;
     sprite_deltas* pIter = (sprite_deltas*)field_50_delta_buffer;
@@ -619,6 +736,7 @@ void gtx_0x106C::build_delta_container_5AAC70()
         off2 += size;
     }
 }
+#endif
 
 MATCH_FUNC(0x5AAD50)
 void gtx_0x106C::load_car_info_5AAD50(u32 cari_chunk_size)
@@ -720,6 +838,34 @@ void gtx_0x106C::load_map_object_info_5AAF00(u32 obji_chunk_len)
 
 MATCH_FUNC(0x5AAF80)
 void gtx_0x106C::load_sprite_index_5AAF80(u32 sprx_chunk_size)
+#if defined(GTA2_PORT_NATIVE)
+{
+    // Native: the SPRX chunk is 8-byte records (offset into the sprite graphics, width,
+    // height, pad). The original reads them straight into sprite_index, whose first
+    // field becomes a pointer later; with 8-byte pointers the array no longer matches
+    // the file, so each record is converted. As in the original, one extra zeroed entry.
+    if ((sprx_chunk_size & ~7u) > 524280)
+    {
+        FatalError_4A38C0(Gta2Error::TooManySprites, "C:\\Splitting\\Gta2\\Source\\style.cpp", 1198, (u32)sprx_chunk_size >> 3);
+    }
+    const u32 count = ((u32)sprx_chunk_size >> 3) + 1;
+    field_20_sprite_index = (sprite_index*)Memory::malloc_4FE4D0(count * sizeof(sprite_index)); // zero-filled
+    u8* pRecords = (u8*)Memory::malloc_4FE4D0(sprx_chunk_size + 8);
+    File::Global_Read_4A71C0(pRecords, sprx_chunk_size);
+    for (u32 i = 0; i + 1 < count; i++)
+    {
+        const u8* pRecord = pRecords + 8 * i;
+        u32 offset;
+        memcpy(&offset, pRecord, sizeof(offset));
+        field_20_sprite_index[i].field_0_pData = (BYTE*)(uintptr_t)offset;
+        field_20_sprite_index[i].field_4_width = pRecord[4];
+        field_20_sprite_index[i].field_5_height = pRecord[5];
+        memcpy(&field_20_sprite_index[i].field_6_pad, pRecord + 6, 2);
+    }
+    crt::free(pRecords);
+    field_4_sprite_index_count = count;
+}
+#else
 {
     field_20_sprite_index = (sprite_index*)Memory::malloc_4FE4D0(sprx_chunk_size + 8);
     File::Global_Read_4A71C0(field_20_sprite_index, sprx_chunk_size);
@@ -729,6 +875,7 @@ void gtx_0x106C::load_sprite_index_5AAF80(u32 sprx_chunk_size)
     }
     field_4_sprite_index_count = ((u32)sprx_chunk_size >> 3) + 1;
 }
+#endif
 

From 60a842056d3218ed1b4edc39aa4792e8921a1e07 Mon Sep 17 00:00:00 2001
From: GTA2 port <port@localhost>
Date: Sat, 7 Nov 2026 20:00:56 -0500
Subject: [PATCH 05/16] native: style sprite index and sprite deltas sized for
 8-byte pointers

The SPRX chunk (8-byte records) was read straight into sprite_index, whose first
field becomes a pointer; it is now converted record by record. The in-memory
delta buffer and delta container used 32-bit sizes (8 * count + 4, 4 * maxSprite
+ 8) and SetDeltaDataPtrs_5AABF0 added the store base through u32 punning; the
native versions use offsetof/sizeof and uintptr_t.
---
 Source/gtx_0x106C.cpp | 147 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 147 insertions(+)

diff --git a/Source/gtx_0x106C.cpp b/Source/gtx_0x106C.cpp
index 8a281e98..752249db 100644
--- a/Source/gtx_0x106C.cpp
+++ b/Source/gtx_0x106C.cpp
@@ -24,6 +24,12 @@ DEFINE_GLOBAL(s16, word_703BAA, 0x703BAA);
 DEFINE_GLOBAL(s16, word_703D98, 0x703D98);
 DEFINE_GLOBAL(s16, word_703C9C, 0x703C9C);
 
+#if defined(GTA2_PORT_NATIVE)
+#include <stddef.h>
+// Native size of one sprite_deltas entry in field_50_delta_buffer (the original: 8 * count + 4).
+#define GTA2_NATIVE_DELTAS_SIZE(count) ((u32)(offsetof(sprite_deltas, field_4_deltas) + (count) * sizeof(sprite_delta)))
+#endif
+
 MATCH_FUNC(0x5AA3B0)
 car_info* gtx_0x106C::get_car_info_5AA3B0(u8 idx)
 {
@@ -410,6 +416,46 @@ void gtx_0x106C::BuildCarInfoContainer_5AA9A0(s32 chunk_size)
 
 MATCH_FUNC(0x5AAB30)
 void gtx_0x106C::load_delx_5AAB30(u32 delx_chunk_size)
+#if defined(GTA2_PORT_NATIVE)
+{
+    // Native: field_50_delta_buffer is built here, in memory only; its entries hold
+    // pointers, so their size comes from the structures instead of the 32-bit
+    // "8 * count + 4". The file side (delta_entry, 2 * count + 4) is unchanged.
+    delta_entry* pIter = field_4C_delta_index;
+    u32 off = 0;
+    u32 total = 0;
+    field_60_delta_len = 0;
+    for (; off < delx_chunk_size;)
+    {
+        u32 size = 2 * pIter->field_2_delta_count + 4;
+        field_60_delta_len += GTA2_NATIVE_DELTAS_SIZE(pIter->field_2_delta_count);
+        pIter = (delta_entry*)((u8*)pIter + size);
+        off += size;
+    }
+
+    field_50_delta_buffer = (sprite_deltas*)Memory::malloc_4FE4D0(field_60_delta_len);
+    delta_entry* pSrc = field_4C_delta_index;
+    u32 off2 = 0;
+    sprite_deltas* pDst = (sprite_deltas*)field_50_delta_buffer;
+    for (; off2 < delx_chunk_size;)
+    {
+        pDst->field_0_which_sprite = pSrc->field_0_which_sprite;
+        pDst->field_2_count = pSrc->field_2_delta_count;
+        pDst->field_3_pad = 0;
+        for (u32 i = 0; i < pSrc->field_2_delta_count; i++)
+        {
+            pDst->field_4_deltas[i].field_4_len = pSrc->field_4_delta[i];
+            // An offset into the delta store until SetDeltaDataPtrs_5AABF0.
+            pDst->field_4_deltas[i].field_0_pData = (delta_store_entry*)(uintptr_t)total;
+            total += pDst->field_4_deltas[i].field_4_len;
+        }
+        u32 size = 2 * pSrc->field_2_delta_count + 4;
+        pDst = (sprite_deltas*)((u8*)pDst + GTA2_NATIVE_DELTAS_SIZE(pDst->field_2_count));
+        off2 += size;
+        pSrc = (delta_entry*)((u8*)pSrc + size);
+    }
+}
+#else
 {
     delta_entry* pIter = field_4C_delta_index;
     u32 off = 0;
@@ -447,10 +493,29 @@ void gtx_0x106C::load_delx_5AAB30(u32 delx_chunk_size)
         pSrc = (delta_entry*)((u8*)pSrc + size);
     }
 }
+#endif
 
 // https://decomp.me/scratch/vwSG1 TODO: fix this hack
 MATCH_FUNC(0x5AABF0)
 void gtx_0x106C::SetDeltaDataPtrs_5AABF0()
+#if defined(GTA2_PORT_NATIVE)
+{
+    // Native: the same as the original's u32 arithmetic (each delta's store offset plus
+    // the store's address), on the native entry layout.
+    sprite_deltas* pIter = (sprite_deltas*)field_50_delta_buffer;
+    for (u32 off = 0; off < (u32)field_60_delta_len;)
+    {
+        for (u32 i = 0; i < pIter->field_2_count; i++)
+        {
+            sprite_delta& delta = pIter->field_4_deltas[i];
+            delta.field_0_pData = (delta_store_entry*)((u8*)field_48_delta_store + (uintptr_t)delta.field_0_pData);
+        }
+        const u32 size = GTA2_NATIVE_DELTAS_SIZE(pIter->field_2_count);
+        pIter = (sprite_deltas*)((u8*)pIter + size);
+        off += size;
+    }
+}
+#else
 {
     s32 size;
     delta_entry* i = (delta_entry*)field_50_delta_buffer;
@@ -465,9 +530,20 @@ void gtx_0x106C::SetDeltaDataPtrs_5AABF0()
         i = (delta_entry*)((char_type*)i + size);
     }
 }
+#endif
 
 MATCH_FUNC(0x5AAC40)
 void gtx_0x106C::SetSpriteIndexDataPtrs_5AAC40()
+#if defined(GTA2_PORT_NATIVE)
+{
+    // Native: field_0_pData holds the offset load_sprite_index_5AAF80 stored.
+    for (u32 i = 0; i < (u16)this->field_4_sprite_index_count; i++)
+    {
+        sprite_index* pIndex = &this->field_20_sprite_index[i];
+        pIndex->field_0_pData = &this->field_34_sprite_graphics[(uintptr_t)pIndex->field_0_pData];
+    }
+}
+#else
 {
     u8* field_0_pData;
     sprite_index* v4;
@@ -479,6 +555,7 @@ void gtx_0x106C::SetSpriteIndexDataPtrs_5AAC40()
         v4->field_0_pData = &this->field_34_sprite_graphics[(u32)field_0_pData];
     }
 }
+#endif
 

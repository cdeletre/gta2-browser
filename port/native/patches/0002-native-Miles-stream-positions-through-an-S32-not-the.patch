From 2948fed0b52ecba54d18752cd95f87c9b94269a3 Mon Sep 17 00:00:00 2001
From: GTA2 port <port@localhost>
Date: Sat, 7 Nov 2026 19:33:31 -0500
Subject: [PATCH 02/16] native: Miles stream positions through an S32, not the
 long parameter

GetVocalPosMs_58E770 and GetVocalLengthMs_58E7A0 reuse their `long`
stream index as AIL_stream_ms_position's output. Miles writes an S32
(4 bytes); `long` is 8 on LP64, so the call does not compile there.
Under GTA2_PORT_NATIVE the position goes through an S32 local.
---
 Source/cSampleManager.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/Source/cSampleManager.cpp b/Source/cSampleManager.cpp
index 13f9b85b..58fa93e5 100644
--- a/Source/cSampleManager.cpp
+++ b/Source/cSampleManager.cpp
@@ -1034,8 +1034,14 @@ s32 cSampleManager::GetVocalPosMs_58E770(long stream_idx)
 {
     if (field_9C_hStreams[stream_idx])
     {
+#if defined(GTA2_PORT_NATIVE)
+        S32 ms = 0; // Miles writes an S32 (4 bytes); `long` is 8 on LP64
+        AIL_stream_ms_position(field_9C_hStreams[stream_idx], 0, &ms);
+        return ms;
+#else
         AIL_stream_ms_position(field_9C_hStreams[stream_idx], 0, &stream_idx);
         return stream_idx;
+#endif
     }
     return 0;
 }
@@ -1045,8 +1051,14 @@ s32 cSampleManager::GetVocalLengthMs_58E7A0(long stream_idx)
 {
     if (field_9C_hStreams[stream_idx])
     {
+#if defined(GTA2_PORT_NATIVE)
+        S32 ms = 0; // Miles writes an S32 (4 bytes); `long` is 8 on LP64
+        AIL_stream_ms_position(field_9C_hStreams[stream_idx], &ms, 0);
+        return ms;
+#else
         AIL_stream_ms_position(field_9C_hStreams[stream_idx], &stream_idx, 0);
         return stream_idx;
+#endif
     }
     return 0;
 }

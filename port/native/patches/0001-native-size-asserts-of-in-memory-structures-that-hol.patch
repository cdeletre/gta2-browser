From 657bd5eb6142d5c600e3c348d55a386e13a9c935 Mon Sep 17 00:00:00 2001
From: GTA2 port <port@localhost>
Date: Sat, 7 Nov 2026 19:32:57 -0500
Subject: [PATCH 01/16] native: size asserts of in-memory structures that hold
 pointers; asserts on the save formats

Under GTA2_PORT_NATIVE (LP64, 8-byte pointers) these structures grow and
their 32-bit size asserts cannot hold. None is read from or written to a
file or the network as bytes, and no code uses their size as a literal,
so only their asserts are left out: Camera_0xBC, Car_BC, Car_Door_10,
CarInfo_808, Ped, Ped_List_4, ScriptStackFrame_C, ScriptStackFramePool_25C,
miss2_0x11C, miss2_8, Sprite_Pool.

The two structures written to disk as bytes gain a native size assert:
SaveData_748 (.svg save) and PlyDat_2BC0 (player data).
---
 Source/Camera.hpp                   | 2 ++
 Source/CarInfo_808.hpp              | 2 ++
 Source/Car_10.hpp                   | 4 +++-
 Source/Car_BC.hpp                   | 2 ++
 Source/Ped.hpp                      | 2 ++
 Source/Ped_List_4.hpp               | 2 ++
 Source/PlyDat_2BC0.hpp              | 5 +++++
 Source/ScriptManager_C1EA8.hpp      | 5 +++++
 Source/ScriptStackFramePool_25C.hpp | 4 ++++
 Source/miss2_0x11C.hpp              | 2 ++
 Source/miss2_8.hpp                  | 4 +++-
 Source/sprite.hpp                   | 2 ++
 12 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/Source/Camera.hpp b/Source/Camera.hpp
index 36e738d3..7e65ad46 100644
--- a/Source/Camera.hpp
+++ b/Source/Camera.hpp
@@ -235,7 +235,9 @@ class Camera_0xBC
     Fix16 field_A8_ui_scale;
     CameraPos field_AC_cam_velocity;
 };
+#if !defined(GTA2_PORT_NATIVE) // holds pointers, in memory only: see docs/native-64bit.md
 GTA2_ASSERT_SIZEOF_ALWAYS(Camera_0xBC, 0xBC)
+#endif
 
 EXTERN_GLOBAL(Camera_0xBC*, gViewCamera_676978);
 

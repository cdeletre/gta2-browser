From 533028f785f800b43f0fdde23b945b3dc4abfcfa Mon Sep 17 00:00:00 2001
From: GTA2 port <port@localhost>
Date: Sat, 7 Nov 2026 20:00:57 -0500
Subject: [PATCH 06/16] native: map column words indexed at 4 bytes; zone list
 pointer size; save format asserts

field_40008_pColumn (the .gmp column words, 4 bytes each) was typed u16** and
indexed directly, so its stride was the pointer size: every column lookup would
read the wrong place on LP64, with no diagnostic. Natively it is u32*.
build_zone_list_4E90E0 allocated 4 * n + 4 for an array of pointers.
Map_sub and gmp_block_info, written to the .svg save as bytes, gain native size
asserts.
---
 Source/map_0x370.cpp | 12 ++++++++++++
 Source/map_0x370.hpp | 12 ++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/Source/map_0x370.cpp b/Source/map_0x370.cpp
index 3c614520..84634288 100644
--- a/Source/map_0x370.cpp
+++ b/Source/map_0x370.cpp
@@ -4458,7 +4458,11 @@ void Map_0x370::GetModifiedMapData_4E8CF0(u16*** outColumnPtr,
                            Map_sub** outSubObj,
                            s32* outSubObjBytes)
 {
+#if defined(GTA2_PORT_NATIVE) // the column words are u32 natively (map_0x370.hpp); the callers use bytes
+    *outColumnPtr = (u16**)&this->field_0_pDmap->field_40008_pColumn[this->field_0_pDmap->field_40000_column_words];
+#else
     *outColumnPtr = &this->field_0_pDmap->field_40008_pColumn[this->field_0_pDmap->field_40000_column_words];
+#endif
 
     const s32 totalColumnWords = this->field_360_column_words;
     const s32 consumedColumnWords = this->field_0_pDmap->field_40000_column_words;
@@ -4557,7 +4561,11 @@ void Map_0x370::build_zone_list_4E90E0(u32 chunk_size)
         in_use_size += zone_data_size;
         pZone = (gmp_map_zone*)((u8*)pZone + zone_data_size);
     }
+#if defined(GTA2_PORT_NATIVE) // the original's 4 * n + 4 counts 4-byte zone pointers
+    field_32C_pZones = (gmp_zone_list*)Memory::malloc_4FE4D0(offsetof(gmp_zone_list, field_4_zone_array) + sizeof(gmp_map_zone*) * num_zones);
+#else
     field_32C_pZones = (gmp_zone_list*)Memory::malloc_4FE4D0(4 * num_zones + 4);
+#endif
 
     in_use_size = 0;
     field_32C_pZones->field_0_num_zones = num_zones;
@@ -4655,7 +4663,11 @@ void Map_0x370::load_dmap_4E92B0(u32 len)
     u32 m_size = field_35C_column_word_extra * sizeof(DWORD);
     u32 column_data_size = field_0_pDmap->field_40000_column_words * sizeof(DWORD);
 
+#if defined(GTA2_PORT_NATIVE)
+    field_0_pDmap->field_40008_pColumn = (u32*)Memory::malloc_4FE4D0(m_size);
+#else
     field_0_pDmap->field_40008_pColumn = (u16**)Memory::malloc_4FE4D0(m_size);
+#endif
 
     File::Global_Read_4A71C0(field_0_pDmap->field_40008_pColumn, column_data_size);
 
diff --git a/Source/map_0x370.hpp b/Source/map_0x370.hpp
index 2e378e21..246f498f 100644
--- a/Source/map_0x370.hpp
+++ b/Source/map_0x370.hpp
@@ -119,7 +119,13 @@ struct gmp_compressed_map_32
     u32 field_0_base[256][256];
     s32 field_40000_column_words;
     s32 field_40004_num_blocks;
+#if defined(GTA2_PORT_NATIVE)
+    // The .gmp column words (4 bytes each), indexed directly (&field_40008_pColumn[base]).
+    // As u16** the index stride is the pointer size: 4 on Win32, 8 on LP64.
+    u32* field_40008_pColumn;
+#else
     u16** field_40008_pColumn;
+#endif
     gmp_block_info* field_4000C_block;
 
     gmp_block_info* get_block(u32 block)
@@ -161,6 +167,12 @@ struct Map_sub
     gmp_dmap_info field_0_dmap_infos[100];
     s32 field_320_max_idx;
 };
+#if defined(GTA2_PORT_NATIVE)
+// Written to the .svg save as bytes after SaveData_748 (ScriptManager_C1EA8.cpp), with the
+// modified gmp_block_info records: their sizes must not change.
+GTA2_ASSERT_SIZEOF_ALWAYS(Map_sub, 0x324)
+GTA2_ASSERT_SIZEOF_ALWAYS(gmp_block_info, 0xC)
+#endif
 
 class gmp_map_zone
 {

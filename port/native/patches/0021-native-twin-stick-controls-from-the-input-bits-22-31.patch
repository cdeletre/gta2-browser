+#if defined(GTA2_PORT_NATIVE)
+// ---- Twin stick (native) ----
+// The console (port/native/platform/input_sdl.cpp) puts a code in the input bits 22-31, which the
+// original never uses: 0 classic controls, 1 twin stick without aiming, 2 + angle / 3 twin stick
+// aiming at that angle (Ang16, as Fix16::atan2_fixed_405320 gives it). The code travels with the
+// keys, so every machine of a match decodes the same thing. It is read only where the port allows
+// it: alone, or in a match whose players all run a console build that knows it
+// (gGta2PortTwinAllowed, set from the lobby's match by net/coop_native.cpp). With a code, the four
+// direction keys walk the ped north, south, west and east on screen (diagonals with two), the ped
+// turns toward the aim (or the way it walks), walks sideways or backwards as it faces, and fires
+// where it faces without the original's lock-on; in a fire truck, tank or gun jeep the turret
+// turns toward the aim. Driving is unchanged.
+extern "C" s32 gGta2PortTwinAllowed;
+s32 gGta2PortTwinAllowed = 0;
+namespace
+{
+struct PortTwin
+{
+    s32 code;   // this tick's
+    s32 hold;   // ticks the aim stays after the stick is let go
+    s32 aim;    // Ang16
+    s32 move;   // Ang16
+    bool moving;
+};
+PortTwin sPortTwin[6];
+const s32 kPortTwinHold = 10;
+const s32 kPortTwinTurn = 96;     // per tick, walking (24 degrees)
+const s32 kPortTwinJumpTurn = 24; // per tick, in a jump
+
+PortTwin* PortTwinOf(Player* pPlayer)
+{
+    const u8 idx = pPlayer ? pPlayer->get_idx_4219D0() : 0xFF;
+    return idx < 6 ? &sPortTwin[idx] : NULL;
+}
+
+// The player whose own ped this is, or null.
+Player* PortTwinPlayerOf(Ped* pPed)
+{
+    Player* pPlayer = pPed ? pPed->field_15C_player : NULL;
+    return pPlayer && pPlayer->field_2C4_player_ped == pPed ? pPlayer : NULL;
+}
+
+s32 PortWrap(s32 d)
+{
+    while (d < -720)
+    {
+        d += 1440;
+    }
+    while (d >= 720)
+    {
+        d -= 1440;
+    }
+    return d;
+}
+} // namespace
+
+// Twin stick allowed now: alone, or in a match that allows it.
+extern "C" s32 Gta2Port_TwinGate()
+{
+    return !bStartNetworkGame_7081F0 || gGta2PortTwinAllowed;
+}
+
+// The game's angle (Ang16, 0..1439) of a direction on the map (x right, y down).
+extern "C" s32 Gta2Port_AngleOf(s32 x, s32 y)
+{
+    return Fix16::atan2_fixed_405320(Fix16(y), Fix16(x)).rValue;
+}
+
+bool PortTwinMoving(Ped* pPed, Ang16* pMove)
+{
+    PortTwin* t = PortTwinOf(PortTwinPlayerOf(pPed));
+    if (!t || !t->code || !t->moving)
+    {
+        return false;
+    }
+    *pMove = Ang16(static_cast<s16>(t->move), static_cast<u8>(0));
+    return true;
+}
+
+bool PortTwinAiming(Ped* pPed, Ang16* pAim)
+{
+    PortTwin* t = PortTwinOf(PortTwinPlayerOf(pPed));
+    if (!t || !t->code || t->hold <= 0)
+    {
+        return false;
+    }
+    *pAim = Ang16(static_cast<s16>(t->aim), static_cast<u8>(0));
+    return true;
+}
+
+// Player::DoPedControlInputs_566C80 with a twin stick code: turn and walk; false without one.
+static bool PortTwinWalk(Player* pPlayer, Ped* pPed)
+{
+    PortTwin* t = PortTwinOf(pPlayer);
+    if (!t || !t->code)
+    {
+        return false;
+    }
+    const s32 mx = (pPlayer->field_7B_bNowRightPressed ? 1 : 0) - (pPlayer->field_7A_bNowLeftPressed ? 1 : 0);
+    const s32 my = (pPlayer->field_79_bNowDownPressed ? 1 : 0) - (pPlayer->field_78_bNowForwardPressed ? 1 : 0);
+    t->moving = mx != 0 || my != 0;
+    if (t->moving)
+    {
+        t->move = Gta2Port_AngleOf(mx, my);
+        pPed->CancelEnterCarObjective_45C5C0();
+    }
+    const s32 desired = t->hold > 0 ? t->aim : t->moving ? t->move : -1;
+    s32 turn = 0;
+    if (desired >= 0 && pPed->field_168_game_object)
+    {
+        const s32 limit = pPlayer->field_64_bJumping ? kPortTwinJumpTurn : kPortTwinTurn;
+        turn = PortWrap(desired - pPed->field_168_game_object->get_rotation_433A40().rValue);
+        turn = turn > limit ? limit : turn < -limit ? -limit : turn;
+    }
+    pPlayer->field_8_turn_speed = Ang16(static_cast<s16>(turn), static_cast<u8>(0));
+    pPlayer->field_C_move_direction = t->moving ? kOne_6FE614 : kZero_6FE610;
+    return true;
+}
+#endif
+
 MATCH_FUNC(0x566520)
 void Player::CharacterControls_566520()
 {
     int input = this->field_4_inputs;
+#if defined(GTA2_PORT_NATIVE)
+    if (PortTwin* t = PortTwinOf(this))
+    {
+        t->code = Gta2Port_TwinGate() ? (static_cast<u32>(input) >> 22) & 0x3FF : 0;
+        if (t->code >= 2)
+        {
+            t->aim = (t->code - 2) * 3;
+            t->hold = kPortTwinHold;
+        }
+        else if (t->code == 0)
+        {
+            t->hold = 0;
+        }
+        else if (t->hold > 0)
+        {
+            --t->hold;
+        }
+    }
+#endif
 
     // up arrow 0x1
     bool forwardGas = (input & 1) == 1;
@@ -1525,6 +1664,16 @@ void Player::DoCarControlInputs_566C30(Car_BC* pCar)
                                  this->field_81_bNowSpecial_1_Pressed,
                                  this->field_84_bWasSpecial_1_Pressed,
                                  bAttackPressed);
+#if defined(GTA2_PORT_NATIVE)
+    // twin stick: the roof gun turns toward the aim
+    if (PortTwin* t = PortTwinOf(this))
+    {
+        if (t->code && t->hold > 0 && (pCar->IsFireTruck_4118F0() || pCar->IsTank_411900() || pCar->IsGunJeep_411910()))
+        {
+            pCar->RotateRoofObjectTowardTarget_440C10(Ang16(static_cast<s16>(t->aim), static_cast<u8>(0)));
+        }
+    }
+#endif
 }
 

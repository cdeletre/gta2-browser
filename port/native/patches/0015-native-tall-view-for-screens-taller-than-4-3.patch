 #endif
 
     gpMapRenderer_6F66E4->Draw_4F6A20(); // Note: Also seems to draw sprites
@@ -425,6 +431,9 @@ void Game_0x40::Draw_4B92D0()
 
 #ifdef GTA2_PORT
     Gta2Port_SetFrameLayout(gViewCamera_676978->field_68_screen_px_width, gViewCamera_676978->PortHudOffsetX());
+#if defined(GTA2_PORT_NATIVE)
+    Gta2Port_SetFrameHeight(gViewCamera_676978->field_6C_screen_px_height, gViewCamera_676978->PortHudOffsetY());
+#endif
     if (Gta2Port_InterpIsExtraDraw())
     {
         Gta2Port_HudReplay(); // a draw between updates: the HUD as last drawn (it services timers while drawing)

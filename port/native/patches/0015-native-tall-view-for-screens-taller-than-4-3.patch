From ce31de4e00ed2c6bffb21f4dade660e7b73a17a2 Mon Sep 17 00:00:00 2001
From: cdeletre <cyril.deletre@gmail.com>
Date: Sun, 8 Nov 2026 07:26:19 -0500
Subject: [PATCH 15/16] native: tall view for screens taller than 4:3

A screen taller than 4:3 (720x720, 1920x1680) gets a 640-wide view as tall
as its shape. The 4:3 box keeps its scale: the projection, HUD scale and
tile and sprite ranges come from it, and more world shows above and below.
The HUD's top parts stay at the top edge, the rest is centred. With the
activation margin the camera boundaries cover the extra height too, as
they cover the extra width of a wide screen.
---
 Source/Camera.cpp         | 10 ++++++++++
 Source/Camera.hpp         | 28 ++++++++++++++++++++++++++++
 Source/Game_0x40.cpp      |  9 +++++++++
 Source/Hud.cpp            | 32 ++++++++++++++++++++++++++++----
 Source/MapRenderer.cpp    |  5 +++++
 Source/SpriteGrid_400.cpp |  4 ++++
 6 files changed, 84 insertions(+), 4 deletions(-)

diff --git a/Source/Camera.cpp b/Source/Camera.cpp
index 75de08d0..8cbb482d 100644
--- a/Source/Camera.cpp
+++ b/Source/Camera.cpp
@@ -425,6 +425,12 @@ void Camera_0xBC::UpdateBoundaries_435B90()
     v = v_y;
 #endif
     v *= dword_6768E0;
+#if defined(GTA2_PORT_NATIVE)
+    if (gGta2PortActivationMargin)
+    {
+        v += PortTallExtraY(z); // native tall view: the boundaries cover the extra height too
+    }
+#endif
 
     field_78_boundaries_non_neg.field_8_top = field_98_cam_pos2.field_4_y - v;
     if (field_78_boundaries_non_neg.field_8_top < kZero_676818)
@@ -613,7 +619,11 @@ void Camera_0xBC::SetScreenSize_4361B0(u32 x_pos, u32 y_pos)
     field_60.y = Fix16(-1);
 
 #ifdef GTA2_PORT
+#if defined(GTA2_PORT_NATIVE)
+    field_A8_ui_scale = Fix16(PortRefHeight()) / 480; // the 4:3 box, also in a tall view
+#else
     field_A8_ui_scale = Fix16(y_pos) / 480; // same as x / 640 at 4:3
+#endif
 #else
     field_A8_ui_scale = Fix16(x_pos) / 640;
 #endif
diff --git a/Source/Camera.hpp b/Source/Camera.hpp
index 7e65ad46..e7c59e4b 100644
--- a/Source/Camera.hpp
+++ b/Source/Camera.hpp
@@ -80,8 +80,36 @@ class Camera_0xBC
     // Widescreen presentation: the screen is wider than the 4:3 reference box of the same height.
     s32 PortRefWidth() const
     {
+#if defined(GTA2_PORT_NATIVE)
+        // Native tall view (a screen taller than 4:3): the 4:3 box is as wide as the screen.
+        const s32 w = field_6C_screen_px_height * 4 / 3;
+        return field_68_screen_px_width < w ? field_68_screen_px_width : w;
+#else
         return field_6C_screen_px_height * 4 / 3;
+#endif
+    }
+#if defined(GTA2_PORT_NATIVE)
+    s32 PortRefHeight() const
+    {
+        return PortRefWidth() * 3 / 4;
+    }
+    // Vertical offset of the centred 4:3 box inside a tall screen.
+    s32 PortHudOffsetY() const
+    {
+        return (field_6C_screen_px_height - PortRefHeight()) / 2;
+    }
+    // World height (each side, at ground level) that a tall screen shows beyond the 4:3 view,
+    // for a camera at height z.
+    Fix16 PortTallExtraY(Fix16 z) const
+    {
+        if (field_6C_screen_px_height <= PortRefHeight() || field_98_cam_pos2.field_C_zoom <= Fix16(0))
+        {
+            return Fix16(0);
+        }
+        return (z + Fix16(8)) / field_98_cam_pos2.field_C_zoom * (field_6C_screen_px_height - PortRefHeight()) /
+            PortRefWidth() / 2;
     }
+#endif
     // Horizontal offset of the centred 4:3 box (HUD space) inside the wide screen.
     s32 PortHudOffsetX() const
     {

 MATCH_FUNC(0x4bbbb0)
@@ -3194,6 +3199,20 @@ void Hud_PauseScreen_2::DrawPause_5D63B0()
 // centre or right edge (port/render/frame.cpp). gGta2PortHudEdges = 0 keeps the whole HUD centred.
 extern "C" void Gta2Port_SetFrameLayout(s32 width, s32 hudOffsetX);
 extern "C" s32 gGta2PortHudEdges;
+#if defined(GTA2_PORT_NATIVE)
+// Native tall view: the same with the top edge, centre or bottom edge (port/render/frame.cpp).
+extern "C" void Gta2Port_SetFrameHeight(s32 height, s32 hudOffsetY);
+static void PortHudAnchor(s32 side, s32 vside = 1) // side: 0 left, 1 centre, 2 right; vside: 0 top, 1 centre, 2 bottom
+{
+    const Camera_0xBC* pCam = gViewCamera_676978;
+    if (pCam)
+    {
+        Gta2Port_SetFrameLayout(pCam->field_68_screen_px_width, pCam->PortHudOffsetX() * (gGta2PortHudEdges ? side : 1));
+        Gta2Port_SetFrameHeight(pCam->field_6C_screen_px_height, pCam->PortHudOffsetY() * (gGta2PortHudEdges ? vside : 1));
+    }
+}
+#define PORT_HUD_ANCHOR_V(side, vside) PortHudAnchor(side, vside)
+#else
 static void PortHudAnchor(s32 side) // 0 left, 1 centre, 2 right
 {
     const Camera_0xBC* pCam = gViewCamera_676978;
@@ -3202,9 +3221,12 @@ static void PortHudAnchor(s32 side) // 0 left, 1 centre, 2 right
         Gta2Port_SetFrameLayout(pCam->field_68_screen_px_width, pCam->PortHudOffsetX() * (gGta2PortHudEdges ? side : 1));
     }
 }
+#define PORT_HUD_ANCHOR_V(side, vside) PortHudAnchor(side)
+#endif
 #define PORT_HUD_ANCHOR(side) PortHudAnchor(side)
 #else
 #define PORT_HUD_ANCHOR(side)
+#define PORT_HUD_ANCHOR_V(side, vside)
 #endif
 
